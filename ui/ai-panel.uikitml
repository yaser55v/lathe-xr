<style>
  .card {
    display: flex;
    flex-direction: column;
    width: 50;
    padding: 2;
    background-color: #111215;
    border-color: #2f89c6;
    border-width: 0.15;
    border-radius: 2.5;
  }

  .eyebrow {
    font-size: 1.7;
    color: #8abfe7;
    letter-spacing: 0.08;
    margin-bottom: 0.7;
  }

  .title {
    font-size: 3.8;
    font-weight: bold;
    color: #fafafa;
    text-align: left;
    margin-bottom: 1;
  }

  .source {
    font-size: 1.45;
    color: #8c919b;
    text-align: left;
    margin-bottom: 1.2;
  }

  .response {
    font-size: 1.95;
    color: #d4d4d8;
    text-align: left;
    line-height: 1.55;
    margin-bottom: 1.5;
  }

  .section-title {
    font-size: 1.55;
    color: #8abfe7;
    margin-bottom: 0.6;
  }

  .media {
    padding: 1;
