<style>
  .card {
    display: flex;
    flex-direction: column;
    width: 46;
    padding: 2.1;
    background-color: #0e1013;
    border-color: #2a2f38;
    border-width: 0.12;
    border-radius: 2.6;
  }

  .top-row {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.9;
  }

  .label {
    font-size: 1.65;
    color: #6d7480;
    letter-spacing: 0.14;
  }

  .top-actions {
    display: flex;
    align-items: center;
    gap: 0.8;
  }

  .lang-button {
    padding: 0.55 1.05;
    background-color: #141820;
    border-color: #31536d;
    border-width: 0.1;
    border-radius: 999;
  }

  .lang-button:hover {
    background-color: #18202a;
  }

  .lang-button-text {
    font-size: 1.4;
    color: #d7e7f4;
    text-align: center;
  }

  .icon-button {
    width: 3.6;
    height: 3.6;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #14171b;
    border-color: #262c34;
    border-width: 0.1;
    border-radius: 999;
  }

  .icon-button:hover {
    background-color: #1a1f26;
  }

  .close-icon {
    font-size: 1.8;
    color: #c7cbd3;
    text-align: center;
  }

  .title {
    font-size: 4.25;
    font-weight: bold;
    color: #f6f7f9;
    text-align: left;
    margin-bottom: 0.95;
  }

  .info-shell {
    display: flex;
    flex-direction: column;
    width: 100%;
    opacity: 1;
  }

  .description {
    font-size: 2;
    color: #a3acb8;
    text-align: left;
    line-height: 1.58;
    margin-bottom: 1.5;
  }

  .footer-row {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    gap: 1;
  }

  .hint {
    flex-grow: 1;
    font-size: 1.55;
    color: #7b8593;
    text-align: left;
    line-height: 1.4;
  }

  .ai-button {
    background-color: #132636;
    border-color: #2d709b;
  }

  .ai-button:hover {
    background-color: #173044;
  }

  .ai-icon {
    font-size: 1.9;
    color: #f4fbff;
    text-align: center;
  }

  .chat-shell {
    display: none;
    flex-direction: column;
    width: 100%;
    margin-top: 0.2;
    opacity: 0;
  }

  .divider {
    width: 100%;
    height: 0.1;
    background-color: #1f242b;
    margin-bottom: 1.3;
  }

  .chat-messages {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 16.5;
    overflow: scroll;
    align-items: stretch;
    gap: 1.4;
    padding-right: 0.3;
  }

  .message-row {
    display: none;
    width: 100%;
    min-height: 5.4;
    align-items: flex-start;
  }

  .message-bubble {
    width: 68;
    padding: 1 1.15;
    border-radius: 1.55;
    border-width: 0.1;
    background-color: #171c22;
    border-color: #27313b;
  }

  .message-text {
    font-size: 1.7;
    color: #edf0f4;
    text-align: left;
    line-height: 1.5;
  }

  .media-grid {
    display: none;
    width: 100%;
    flex-direction: row;
    gap: 0.9;
    margin-top: 1.2;
    opacity: 0;
  }

  .media-card {
    display: none;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.1;
    background-color: #131820;
    border-color: #27313d;
    border-width: 0.1;
    border-radius: 1.35;
  }

  .media-kind {
    font-size: 1.25;
    color: #7dbde8;
    letter-spacing: 0.08;
    margin-bottom: 0.35;
  }

  .media-title {
    font-size: 1.6;
    color: #f3f5f8;
    margin-bottom: 0.25;
  }

  .media-subtitle {
    font-size: 1.35;
    color: #8993a0;
    line-height: 1.35;
  }

  .composer {
    display: flex;
    width: 100%;
    gap: 0.8;
    align-items: center;
    margin-top: 1.3;
  }

  .chat-input {
    flex-grow: 1;
    width: 100%;
    min-height: 4.3;
    padding: 0.95 1.2;
    background-color: #12161c;
    border-color: #27303a;
    border-width: 0.1;
    border-radius: 1.45;
    color: #f6f7f8;
    font-size: 1.7;
  }

  .send-button {
    background-color: #15293a;
    border-color: #2e6f99;
  }

  .send-button:hover {
    background-color: #193145;
  }

  .send-icon {
    font-size: 1.95;
    color: #f4fbff;
    text-align: center;
  }
</style>

<div class="card">
  <div class="top-row">
    <Text id="card-label" class="label">ISPEZIONE PEZZO</Text>

    <div class="top-actions">
      <button id="language-button" class="lang-button">
        <Text id="language-button-text" class="lang-button-text">IT</Text>
      </button>

      <button id="close-button" class="icon-button">
        <Text id="close-icon" class="close-icon">X</Text>
      </button>
    </div>
  </div>

  <div id="info-shell" class="info-shell">
    <Text id="part-title" class="title">Apron / Handwheel</Text>
    <Text id="part-description" class="description">La grande ruota frontale usata per spostare manualmente il carro lungo l'asse e controllare l'avanzamento.</Text>

    <div class="footer-row">
      <Text id="part-hint" class="hint">Apri l'assistenza AI per una spiegazione contestuale del componente.</Text>

      <button id="ask-ai-button" class="icon-button ai-button">
        <Text id="ask-ai-icon" class="ai-icon">✦</Text>
      </button>
    </div>
  </div>

  <div id="chat-shell" class="chat-shell">
    <div class="divider"></div>

    <div id="chat-messages" class="chat-messages">
      <div id="message-0-row" class="message-row">
        <div id="message-0-bubble" class="message-bubble">
          <Text id="message-0-text" class="message-text">.</Text>
        </div>
      </div>
      <div id="message-1-row" class="message-row">
        <div id="message-1-bubble" class="message-bubble">
          <Text id="message-1-text" class="message-text">.</Text>
        </div>
      </div>
      <div id="message-2-row" class="message-row">
        <div id="message-2-bubble" class="message-bubble">
          <Text id="message-2-text" class="message-text">.</Text>
        </div>
      </div>
      <div id="message-3-row" class="message-row">
        <div id="message-3-bubble" class="message-bubble">
          <Text id="message-3-text" class="message-text">.</Text>
        </div>
      </div>
      <div id="message-4-row" class="message-row">
        <div id="message-4-bubble" class="message-bubble">
          <Text id="message-4-text" class="message-text">.</Text>
        </div>
      </div>
      <div id="message-5-row" class="message-row">
        <div id="message-5-bubble" class="message-bubble">
          <Text id="message-5-text" class="message-text">.</Text>
        </div>
      </div>
    </div>

    <div id="media-grid" class="media-grid">
      <div id="media-0-card" class="media-card">
        <Text id="media-0-kind" class="media-kind"></Text>
        <Text id="media-0-title" class="media-title"></Text>
        <Text id="media-0-subtitle" class="media-subtitle"></Text>
      </div>

      <div id="media-1-card" class="media-card">
        <Text id="media-1-kind" class="media-kind"></Text>
        <Text id="media-1-title" class="media-title"></Text>
        <Text id="media-1-subtitle" class="media-subtitle"></Text>
      </div>
    </div>

    <div class="composer">
      <input id="chat-input" class="chat-input"></input>

      <button id="send-button" class="icon-button send-button">
        <Text id="send-icon" class="send-icon">›</Text>
      </button>
    </div>
  </div>
</div>
